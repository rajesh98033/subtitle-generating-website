# ── Required ──────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────
# Everything below has a built-in default; uncomment a line only to change it.
# Locally these go in .env.local; in production, set them in your host's
# dashboard (e.g. Railway/Render "Variables"). Restart the app after changing.

# Usage limits (per visitor unless noted)
# MAX_VIDEO_SECONDS=60             # longest video accepted
# MAX_UPLOAD_MB=150                # largest file accepted
# DAILY_VIDEO_LIMIT=10             # subtitle generations per day
# DAILY_RENDER_LIMIT=10            # "burn into video" renders per day
# IP_DAILY_LIMIT=50                # per-network backstop for cleared cookies
# GLOBAL_DAILY_AUDIO_MINUTES=450   # total for everyone; keep under Groq's daily limit (~480 on free tier)
# LIMITS_TIMEZONE=Asia/Kathmandu   # daily limits reset at midnight here
